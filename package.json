{
  "name": "oshi-rental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:user-state": "node --test tests/firebase_user_state.test.mjs",
    "test:inventory": "node --test tests/rental_inventory.test.mjs",
    "test:waitlist": "node --test tests/waitlist_notifications.test.mjs",
    "build": "sass src/scss/style.scss src/scss/style.css --style=expanded --no-source-map",
    "release": "npm run build && node scripts/package_site.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write \"*.html\" \"assets/js/*.js\" \"scripts/*.mjs\" \"src/scss/*.scss\"",
    "format:check": "prettier --check \"*.html\" \"assets/js/*.js\" \"scripts/*.mjs\" \"src/scss/*.scss\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "sass": "^1.83.0"
  }
}
